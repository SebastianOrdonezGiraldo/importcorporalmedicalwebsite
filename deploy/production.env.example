# Copiar a production.env en el servidor (chmod 600). No se incluye en la imagen.
# Valores literales, sin comillas; no usar saltos de línea en los valores.
SITE_URL=https://www.importcorporalmedical.com
STORAGE_DRIVER=r2
GOOGLE_SITE_VERIFICATION=
ADMIN_PASSWORD=
SESSION_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=importwebsite
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=import-corporal-medical
# Mantener false al importar el catálogo existente.
ALLOW_CATALOG_INITIALIZATION=false
