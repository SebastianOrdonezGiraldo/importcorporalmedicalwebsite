# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Cadena aleatoria larga para firmar la sesión del admin (genera una con: openssl rand -hex 32)
SESSION_SECRET=

# Carpeta donde se guardan la base de datos (app.db) y las fotos subidas (uploads/).
# En producción debe ser un disco persistente.
DATA_DIR=./data

# URL pública del sitio (para metadatos y enlaces compartidos)
SITE_URL=https://www.importcorporalmedical.com

# Opcional: contenido del meta de verificación entregado por Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Almacenamiento: local conserva el funcionamiento actual; r2 requiere todas las claves siguientes.
# Mantén el bucket PRIVADO: contiene también los respaldos de SQLite.
# El servidor sirve únicamente las imágenes por /media y /assets; nunca expone backups/.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=import-corporal-medical
