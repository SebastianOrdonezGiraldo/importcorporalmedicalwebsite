# Contraseña para entrar a /admin
ADMIN_PASSWORD=cambia-esta-contraseña

# Cadena aleatoria larga para firmar la sesión del admin (genera una con: openssl rand -hex 32)
SESSION_SECRET=

# Carpeta donde se guardan la base de datos (app.db) y las fotos subidas (uploads/).
# En producción debe ser un disco persistente.
DATA_DIR=./data

# URL pública del sitio (para metadatos y enlaces compartidos)
SITE_URL=https://www.importcorporalmedical.com
